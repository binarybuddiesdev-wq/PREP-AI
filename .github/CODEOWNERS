# CODEOWNERS — auto-assign reviewers per path.
#
# Rules: the LAST matching pattern wins. List more specific paths AFTER
# their parents so they take precedence.
#
# Conventions:
#   - @prepai/backend          → server-side owners
#   - @prepai/frontend         → ui-side owners
#   - @prepai/ai               → Mastra / prompt engineers
#   - @prepai/data             → Prisma / schema owners
#   - @prepai/infra            → CI, Docker, scripts, deps
#   - @prepai/docs             → Architecture, ADRs, skills
#   - @prepai/security         → Security policy, auth, webhooks
#   - @prepai/release          → CHANGELOG, version bumps
#
# Until the team grows, replace the team handles with a single personal
# handle (e.g. `@uday`) and add handles as they join in the same PR that
# grants repo access.

# ── Default: every PR needs at least one backend review ───────────
* @prepai/backend

# ── Backend: server-side ownership ─────────────────────────────────
/server/                              @prepai/backend
/server/src/modules/                  @prepai/backend
/server/src/common/                   @prepai/backend
/server/src/config/                   @prepai/backend
/server/src/prisma/                   @prepai/backend @prepai/data
/server/prisma/                       @prepai/backend @prepai/data
/server/test/                         @prepai/backend @prepai/security
/server/nest-cli.json                 @prepai/backend
/server/tsconfig*.json                @prepai/backend
/server/package.json                  @prepai/backend @prepai/infra
/server/vitest.config.ts              @prepai/backend

