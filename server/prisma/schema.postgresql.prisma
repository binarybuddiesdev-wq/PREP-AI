generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/postgresql-client"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRESQL_URL")
}

enum TheoryAnswerStatus {
  queued
  running
  completed
  failed
}

model TheorySession {
  id                String         @id @default(uuid())
  userId            String
  topicId           String? // null for Weak Areas mode (AI picks topics)
  mode              String // "topic" | "weak" | "pdf"
  difficulty        String // "Junior" | "Mid" | "Senior"
  totalQuestions    Int
  questionsAnswered Int            @default(0)
  avgScore          Float          @default(0)
  status            String         @default("in_progress") // "in_progress" | "completed"
  startedAt         DateTime       @default(now())
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  answers           TheoryAnswer[]

  @@index([userId])
  @@index([userId, createdAt])
}

model TheoryAnswer {
  id                      String             @id @default(uuid())
  sessionId               String
  questionId              String? // null for AI-generated questions (Weak Areas / PDF Study)
  questionText            String
  userAnswer              String
  aiScore                 Float?
  aiFeedback              String?
  evaluationProvider      String?
  evaluationModel         String?
  evaluationPromptVersion String?
  status                  TheoryAnswerStatus @default(completed)
  failureMessage          String?
  timeTaken               Int? // seconds
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @default(now()) @updatedAt

  session TheorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status, createdAt])
}

model CodingSession {
  id                String            @id @default(uuid())
  userId            String
  problemIds        String[]          @default([])
  problemsAttempted Int               @default(0)
  problemsSolved    Int               @default(0)
  status            String            @default("in_progress") // "in_progress" | "completed"
  startedAt         DateTime          @default(now())
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  answers           CodingAnswer[]
  executions        CodingExecution[]

  @@index([userId])
  @@index([userId, createdAt])
}

model CodingQuestion {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  difficulty  String // "Easy" | "Medium" | "Hard"
  topic       String // "Arrays" | "Stacks" | "Hash Maps" etc.
  examples    Json // [{ input, output, explanation }]
  constraints String[]
  codeJs      String // JavaScript boilerplate
  codeTs      String // TypeScript boilerplate
  codePy      String // Python boilerplate
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([topic])
  @@index([difficulty])
  @@index([topic, difficulty])
}

model CodingAnswer {
  id              String   @id @default(uuid())
  executionId     String?  @unique
  sessionId       String?
  userId          String
  problemId       String
  language        String // "javascript" | "typescript" | "python"
  code            String
  status          String // "accepted" | "wrong_answer" | "error"
  testCasesPassed Int
  testCasesTotal  Int
  runtime         Int? // ms
  memoryUsage     Int? // MB
  aiReviewJson    Json? // { timeComplexity, spaceComplexity, quality, suggestions }
  createdAt       DateTime @default(now())

  session   CodingSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  execution CodingExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, problemId])
  @@index([sessionId])
  @@index([sessionId, problemId, status])
}

model CodingExecution {
  id                    String    @id @default(uuid())
  sessionId             String
  userId                String
  problemId             String
  operation             String // "run" | "submit"
  language              String
  sourceCode            String
  examples              Json
  queueJobId            String
  quotaKey              String?
  quotaItemKey          String?
  quotaTtlSeconds       Int?
  quotaReservationToken String?
  status                String    @default("queued") // "queued" | "running" | "completed" | "failed"
  result                Json?
  failureMessage        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  startedAt             DateTime?
  completedAt           DateTime?

  session CodingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answer  CodingAnswer?

  @@index([userId, createdAt])
  @@index([sessionId, userId, createdAt])
  @@index([status, createdAt])
  @@index([queueJobId])
}
