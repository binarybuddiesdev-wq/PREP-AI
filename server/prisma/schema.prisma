generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clerkUserId String   @unique
  email       String   @unique
  name        String
  avatarUrl   String?
  role        String   @default("USER")
  isNewUser   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserSettings {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  userId              String   @unique
  profile             Json?
  preferences         Json?
  notifications       Json?
  dailyReminderEnabled Boolean?
  dailyReminderTime    String?
  timezone             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([dailyReminderEnabled])
}

model InAppNotification {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String
  idempotencyKey String
  category       String
  title          String
  body           String
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt, id])
  @@index([userId, readAt, createdAt])
}

model StudyChatConversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  title     String
  messages  Json
  turnCount Int      @default(0)
  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt, id])
}

model StudyChatOperation {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String
  operationId        String
  scope              String
  requestFingerprint String
  status             String   @default("PROCESSING")
  leaseToken         String
  leaseExpiresAt     DateTime
  conversationId     String?  @db.ObjectId
  response           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([userId, operationId])
  @@index([userId, conversationId])
}

model PdfSource {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String
  displayName       String
  byteSize          Int
  contentHash       String
  assetId           String?
  pageCount         Int?
  status            String    @default("uploading")
  activeRevision    Int       @default(0)
  requestedRevision Int       @default(1)
  reindexOperations Json?
  failureCode       String?
  dispatchNeeded    Boolean   @default(false)
  dispatchClaimId   String?
  dispatchClaimedAt DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
}

model Topic {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  category  String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  question        String
  topicId         String   @db.ObjectId
  difficulty      String
  referenceAnswer String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
