{
  "name": "server",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "start:worker": "node --import @swc-node/register/esm-register --env-file=../.env --watch src/worker.main.ts",
    "start:worker:prod": "node dist/worker.main.js",
    "start:dev": "node --import @swc-node/register/esm-register --env-file=../.env --watch src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval:theory": "tsx src/mastra/evals/run-theory-evaluation.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma/schema.postgresql.prisma",
    "prisma:push:mongodb": "prisma db push --schema=prisma/schema.prisma",
    "prisma:questions:backfill-uniqueness": "tsx --env-file=../.env scripts/backfill-question-uniqueness.ts",
    "prisma:push:postgresql": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "prisma:validate:postgresql": "prisma validate --schema=prisma/schema.postgresql.prisma",
    "seed:coding:local": "tsx --env-file=../.env prisma/seed-coding-local.ts",
    "prisma:migrate:postgresql": "prisma migrate dev --schema=prisma/schema.postgresql.prisma"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.2",
    "@clerk/clerk-sdk-node": "5.1.6",
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.7",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.8",
    "@mastra/core": "1.81.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-fastify": "11.2.8",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.4",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "1.30.1",
    "@opentelemetry/core": "1.30.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.2",
    "@opentelemetry/sdk-node": "0.57.2",
    "@prisma/client": "6.19.0",
    "@sentry/nestjs": "10.77.1",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cloudinary": "2.10.0",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pdfjs-dist": "5.4.624",
    "pino": "10.3.1",
    "razorpay": "2.9.5",
    "reflect-metadata": "0.2.2",
    "resend": "6.16.0",
    "rxjs": "7.8.2",
    "svix": "^1.99.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.23",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.8",
    "@opentelemetry/sdk-trace-base": "1.30.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.40",
    "@types/node": "25.9.2",
    "@types/supertest": "7.2.0",
    "@vitest/coverage-v8": "4.1.8",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.3",
    "prisma": "6.19.0",
    "supertest": "7.2.2",
    "tsc-alias": "1.8.17",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "unplugin-swc": "1.5.9",
    "vite": "8.3.5",
    "vitest": "4.1.8"
  }
}
