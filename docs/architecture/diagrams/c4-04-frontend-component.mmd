%% C4 Level 3 — Frontend component and layer diagram.
%% Layer rules are defined in ADR-0009 and frontend-refactor.md.

flowchart TB
    Browser["User Browser"]

    subgraph AppLayer["app — composition root"]
        App["App / AppErrorBoundary"]
        Providers["AppProviders<br/>Clerk · Redux · Query · Router"]
        Routes["AppRoutes / RouteGuards"]
        App --> Providers --> Routes
    end

    subgraph PagesLayer["pages — route shells"]
        Dashboard["DashboardPage"]
        Settings["SettingsPage"]
        SignIn["SignInPage"]
        SignUp["SignUpPage"]
    end

    subgraph LogicLayer["logic — readers and commands"]
        UserReader["useUserReader / useSettingsReader"]
        UpdateCommand["useUpdateSettingsCommand"]
        AuthHooks["useSessionReader / useSignOutCommand"]
        QueryClient["queryClient.ts"]
    end

    subgraph ServiceLayer["service — external I/O adapters"]
        ApiClient["apiClient.ts<br/>ky + Clerk bearer token"]
        UserApi["user.api.ts<br/>getMe / getSettings / updateSettings"]
        ClerkAdapter["auth/<br/>Clerk provider, hooks, widgets"]
        ApiClient --> UserApi
    end

    subgraph DataLayer["data — shared client-owned Redux state"]
        Store["store / rootReducer"]
    end

    subgraph ComponentsLayer["components — presentational UI"]
        Layout["layout / auth / form"]
        DashboardComponents["dashboard"]
        SettingsComponents["settings"]
    end

    subgraph UtilsLayer["utils — pure helpers"]
        Cn["cn"]
        FormatDate["formatDate"]
    end

    subgraph CoreLayer["core — types, constants and configuration"]
        RoutesCore["routes"]
        UserTypes["user types and settings options"]
        ApiTypes["API types and environment"]
    end

    Browser --> App
    Routes --> Dashboard
    Routes --> Settings
    Routes --> SignIn
    Routes --> SignUp
    Dashboard --> UserReader
    Dashboard --> AuthHooks
    Settings --> UserReader
    Settings --> UpdateCommand
    SignIn --> ClerkAdapter
    SignUp --> ClerkAdapter
    UserReader --> ApiClient
    UpdateCommand --> ApiClient
    AuthHooks --> ClerkAdapter
    LogicLayer --> Store
    PagesLayer --> ComponentsLayer
    LogicLayer --> CoreLayer
    ServiceLayer --> CoreLayer
    DataLayer --> CoreLayer
    ComponentsLayer --> CoreLayer
    ComponentsLayer --> UtilsLayer
    PagesLayer --> CoreLayer

    classDef appStyle fill:#312e81,stroke:#818cf8,stroke-width:2px,color:#fff;
    classDef pageStyle fill:#4c1d95,stroke:#a78bfa,stroke-width:2px,color:#fff;
    classDef layerStyle fill:#1e3a8a,stroke:#60a5fa,stroke-width:2px,color:#fff;
    classDef componentStyle fill:#064e3b,stroke:#10b981,stroke-width:2px,color:#fff;
    class App,Providers,Routes appStyle;
    class Dashboard,Settings,SignIn,SignUp pageStyle;
    class UserReader,UpdateCommand,AuthHooks,QueryClient,ApiClient,UserApi,ClerkAdapter,Store layerStyle;
    class Layout,DashboardComponents,SettingsComponents componentStyle;
