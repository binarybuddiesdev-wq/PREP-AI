{
  "name": "prepai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui --project=ui",
    "test:server": "playwright test --project=server",
    "test:chromium": "playwright test --project=ui-chromium --project=server-chromium",
    "report": "playwright show-report",
    "piston:start": "pnpm --filter server exec tsx ../types/piston.ts start",
    "piston:stop": "pnpm --filter server exec tsx ../types/piston.ts stop",
    "piston:remove": "pnpm --filter server exec tsx ../types/piston.ts remove",
    "piston:setup": "pnpm --filter server exec tsx ../types/piston.ts setup",
    "piston:status": "pnpm --filter server exec tsx ../types/piston.ts status",
    "build:viewer": "pnpm --filter server exec tsx ../scripts/build-architecture-viewer.ts",
    "build:viewer:check": "pnpm --filter server exec tsx ../scripts/build-architecture-viewer.ts --check",
    "check:agent-docs": "node scripts/check-agent-docs.js",
    "gate": "node scripts/gate.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .gitignore",
    "commitlint": "commitlint --edit",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "seed": "pnpm --filter server exec tsx --env-file=../.env ../scripts/seed/seed.ts",
    "seed:topics-only": "pnpm --filter server exec tsx --env-file=../.env ../scripts/seed/seed.ts --topics-only",
    "seed:questions-only": "pnpm --filter server exec tsx --env-file=../.env ../scripts/seed/seed.ts --questions-only",
    "docker:up": "podman-compose up -d",
    "docker:down": "podman-compose down -v",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.52.0",
    "@types/node": "22.15.3",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "release-it": "^17.0.0",
    "@release-it/conventional-changelog": "^8.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.0.0"
  }
}
