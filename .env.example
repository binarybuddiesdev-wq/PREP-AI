GEMINI_API_KEY=
MASTRA_API_KEY=

PORT=3000
NODE_ENV=development
VITE_API_BASE_URL=http://localhost:3000
SERVER_HOST_PORT=3000
UI_HOST_PORT=5173

REDIS_PORT=6379
REDIS_HOST=localhost
JOBS_WORKER_ENABLED=true
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB)
DATABASE_URL=mongodb://prepai:prepai@localhost:27017/prepai?authSource=admin&replicaSet=rs0&directConnection=true
POSTGRESQL_URL=postgresql://postgres:postgres@127.0.0.1:5432/prepai
# Configure this with the dedicated prepai_worker role when enabling the RLS rollout.
POSTGRESQL_WORKER_URL=
PISTON_URL=http://127.0.0.1:2000
# Production code execution is disabled by default. The local privileged Piston runner is development-only.
# Enable production execution only with a separately reviewed stronger isolation service.
# PISTON_EXECUTION_ENABLED=true

# NVIDIA NIM (primary LLM provider)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1

# PDF Study v1 limits (PDF.js text extraction; scanned PDFs are not OCR'd)
PDF_MAX_FILE_BYTES=10485760
PDF_MAX_PAGES=100
PDF_MAX_EXTRACTED_CHARS=1000000
PDF_CHUNK_SIZE=512
PDF_CHUNK_OVERLAP=64
PDF_MAX_FILES_PER_USER=5
PDF_MAX_STORAGE_BYTES_PER_USER=52428800
PDF_DAILY_UPLOADS_PER_USER=3
PDF_SIMILARITY_THRESHOLD=0.7

# Groq (fallback LLM provider — free tier: 2M tokens/day on Qwen 3.8 27B)
# Sign up at https://console.groq.com (no credit card required)
# Used automatically when NVIDIA is unavailable or rate-limited.
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
# Daily theory-evaluation token budgets; override for your provider/model costs.
AI_DAILY_TOKENS_FREE=400000
AI_DAILY_TOKENS_PREMIUM=2000000
# Set to "groq" to force Groq even when NVIDIA is healthy (useful for A/B testing).
# Leave unset for auto-failover.
LLM_PROVIDER=groq

#Clerk
CLERK_SECRET_KEY=your_api_secret_here
CLERK_WEBHOOK_SECRET=your_webhook_secret_here
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Resend (Email)
RESEND_API_KEY=re_your_api_key_here

# RazorPay
RAZORPAY_KEY_ID=your_api_key_id_here
RAZORPAY_KEY_SECRET=your_api_secret_here
